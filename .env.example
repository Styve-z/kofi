# Base gérée KOFI / Drizzle
DATABASE_URL=mysql://user:password@localhost:3306/kofi
# Base DÉDIÉE aux tests d’intégration : elle est vidée à chaque exécution de `pnpm test`.
TEST_DATABASE_URL=
# Origines autorisées à appeler l’API depuis un navigateur (ex. app Expo en mode web en développement), séparées par des virgules.
CORS_ORIGINS=

# OAuth Manus déjà utilisé par le starter web. Ne jamais committer les valeurs réelles.
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=
MANUS_API_KEY=

# Paiement Mobile Money (voir documentation/integrations.md)
# Vide = paiement désactivé ; « test » = mode test (interdit en production) ; sinon le prestataire branché.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MODE=full
PAYMENT_DEPOSIT_PERCENT=30
PAYMENT_FREE_CANCEL_HOURS=24
KOFI_COMMISSION_PERCENT=10

# Photos de réalisations : local (développement), s3 ou manus. En production sans réglage : s3 si S3_BUCKET, sinon manus.
STORAGE_DRIVER=
UPLOAD_DIR=uploads
S3_PUBLIC_URL=

# Intégrations à activer avant production
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
MAPS_API_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mails : vide = mode développement (écrits dans outbox/, non envoyés)
APP_URL=http://localhost:3000
EMAIL_PROVIDER=
EMAIL_FROM=
SMS_PROVIDER=
SMS_SENDER=KOFI
# BACKGROUND_JOBS=off  (desactive l'envoi et les rappels sur une instance secondaire)
